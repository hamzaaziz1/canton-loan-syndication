module Test.Syndicate where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSomeNote)
import Syndication.Facility
import Syndication.Syndicate
import Syndication.Allocation
import Test.Setup
import Test.Await

data Invited = Invited with
    parties    : Parties
    mandateCid : ContractId Mandate
    bookCid    : ContractId SyndicateBook
    invA       : ContractId LenderInvitation
    invB       : ContractId LenderInvitation

data ClosedBook = ClosedBook with
    parties        : Parties
    facilityCid    : ContractId FacilityAgreement
    participations : [ContractId Participation]

-- Runs the flow up to open invitations for the given parties.
-- Works on the in-memory ledger and on a multi-node network.
inviteLendersWith : Parties -> Script Invited
inviteLendersWith p = do
  reqCid <- submit p.borrower do
    createCmd MandateRequest with
      borrower = p.borrower
      agent    = p.agent
      terms    = sampleTerms

  -- two roots in one transaction: the borrower is an informee of Accept only
  let book = SyndicateBook with
        agent = p.agent
        terms = sampleTerms
  (mandateCid, bookCid) <- submit p.agent $
    (,) <$> exerciseCmd reqCid Accept <*> createCmd book

  invA <- submit p.agent do exerciseCmd bookCid Invite with lender = p.lenderA
  invB <- submit p.agent do exerciseCmd bookCid Invite with lender = p.lenderB
  awaitSome "invitation at lender A" (queryContractId p.lenderA invA)
  awaitSome "invitation at lender B" (queryContractId p.lenderB invB)

  pure Invited with
    parties    = p
    mandateCid = mandateCid
    bookCid    = bookCid
    invA       = invA
    invB       = invB

inviteLenders : Script Invited
inviteLenders = setupParties >>= inviteLendersWith

closeBookWith : Parties -> Script ClosedBook
closeBookWith p = do
  inv <- inviteLendersWith p

  -- oversubscribed: 110m committed against a 100m target
  comA <- submit p.lenderA do exerciseCmd inv.invA Commit with amount = 60000000.0
  comB <- submit p.lenderB do exerciseCmd inv.invB Commit with amount = 50000000.0
  awaitSome "commitment A at agent" (queryContractId p.agent comA)
  awaitSome "commitment B at agent" (queryContractId p.agent comB)

  -- scale back to 100m in one atomic close
  (facilityCid, participations) <- submit p.agent do
    exerciseCmd inv.bookCid Close with
      mandateCid  = inv.mandateCid
      allocations = [(comA, 55000000.0), (comB, 45000000.0)]

  case participations of
    [partA, partB] -> do
      awaitSome "participation at lender A" (queryContractId p.lenderA partA)
      awaitSome "participation at lender B" (queryContractId p.lenderB partB)
    _ -> abort "expected two participations"
  awaitSome "facility at borrower" (queryContractId p.borrower facilityCid)

  pure ClosedBook with
    parties        = p
    facilityCid    = facilityCid
    participations = participations

closeBook : Script ClosedBook
closeBook = setupParties >>= closeBookWith

-- Who sees what after the close. Checks contract ids rather than exact lists,
-- so it also holds on a ledger that already has earlier runs on it.
checkCloseBookVisibility : ClosedBook -> Script ()
checkCloseBookVisibility cb = do
  let p = cb.parties
  (partA, partB) <- case cb.participations of
    [a, b] -> pure (a, b)
    _      -> abort "expected two participations"

  -- each lender sees its own allocation and never the other's
  aSeen <- map fst <$> query @Participation p.lenderA
  assertMsg "lender A sees its own participation" (partA `elem` aSeen)
  assertMsg "lender A must not see lender B's participation" (not (partB `elem` aSeen))
  bSeen <- map fst <$> query @Participation p.lenderB
  assertMsg "lender B sees its own participation" (partB `elem` bSeen)
  assertMsg "lender B must not see lender A's participation" (not (partA `elem` bSeen))

  pa <- fromSomeNote "lender A participation" <$> queryContractId p.lenderA partA
  pa.amount === 55000000.0
  pb <- fromSomeNote "lender B participation" <$> queryContractId p.lenderB partB
  pb.amount === 45000000.0

  -- the agent sees both
  agentSeen <- map fst <$> query @Participation p.agent
  assertMsg "agent sees both participations" (partA `elem` agentSeen && partB `elem` agentSeen)

  -- the borrower sees the facility total and nothing about the split
  fac <- fromSomeNote "borrower should see the facility" <$> queryContractId p.borrower cb.facilityCid
  fac.facilityAmount === 100000000.0
  borrowerParts <- query @Participation p.borrower
  borrowerParts === []

  -- lenders never see the borrower's side
  lenderFacs <- query @FacilityAgreement p.lenderA
  lenderFacs === []

test_open_book_visibility : Script ()
test_open_book_visibility = do
  inv <- inviteLenders
  let p = inv.parties

  -- the book is agent-only, even though it was created in the same
  -- transaction as the borrower's mandate
  borrowerBooks <- query @SyndicateBook p.borrower
  borrowerBooks === []

  -- each lender sees only its own invitation
  aInvs <- query @LenderInvitation p.lenderA
  map fst aInvs === [inv.invA]
  bInvs <- query @LenderInvitation p.lenderB
  map fst bInvs === [inv.invB]
  borrowerInvs <- query @LenderInvitation p.borrower
  borrowerInvs === []

  _ <- submit p.lenderA do exerciseCmd inv.invA Commit with amount = 60000000.0
  _ <- submit p.lenderB do exerciseCmd inv.invB Commit with amount = 50000000.0

  -- each lender sees only its own commitment, the borrower sees none
  aComs <- query @Commitment p.lenderA
  map (\(_, c) -> c.amount) aComs === [60000000.0]
  bComs <- query @Commitment p.lenderB
  map (\(_, c) -> c.amount) bComs === [50000000.0]
  borrowerComs <- query @Commitment p.borrower
  borrowerComs === []

test_close_book_visibility : Script ()
test_close_book_visibility = closeBook >>= checkCloseBookVisibility

test_syndicate_authorisation : Script ()
test_syndicate_authorisation = do
  inv <- inviteLenders
  let p = inv.parties

  -- lenderA cannot commit on lenderB's invitation: to lenderA it does not exist
  submitMustFail p.lenderA do exerciseCmd inv.invB Commit with amount = 1.0

  -- the agent cannot commit on a lender's behalf
  submitMustFail p.agent do exerciseCmd inv.invA Commit with amount = 1.0

  comA <- submit p.lenderA do exerciseCmd inv.invA Commit with amount = 60000000.0

  -- scale up is rejected
  submitMustFail p.agent do
    exerciseCmd inv.bookCid Close with
      mandateCid  = inv.mandateCid
      allocations = [(comA, 70000000.0)]

  -- a lender cannot close the book
  submitMustFail p.lenderA do
    exerciseCmd inv.bookCid Close with
      mandateCid  = inv.mandateCid
      allocations = [(comA, 60000000.0)]

  -- an empty close is rejected
  submitMustFail p.agent do
    exerciseCmd inv.bookCid Close with
      mandateCid  = inv.mandateCid
      allocations = []
