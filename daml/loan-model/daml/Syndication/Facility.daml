module Syndication.Facility where

import Syndication.Types

-- Everything in this module has the borrower as a stakeholder.
-- Lender-side contracts live in Syndicate and Allocation.

template MandateRequest
  with
    borrower : Party
    agent    : Party
    terms    : FacilityTerms
  where
    signatory borrower
    observer agent

    ensure terms.totalAmount > 0.0 && terms.marginBps >= 0

    -- consuming by default: accepting archives the request, so it can't be accepted twice
    choice Accept : ContractId Mandate
      controller agent
      do
        create Mandate with
          borrower = borrower
          agent    = agent
          terms    = terms

    choice Reject : ()
      with
        reason : Text
      controller agent
      do pure ()

    choice Withdraw : ()
      controller borrower
      do pure ()

template Mandate
  with
    borrower : Party
    agent    : Party
    terms    : FacilityTerms
  where
    signatory borrower, agent

    -- Called from SyndicateBook.Close with the total only, never the per-lender split.
    choice Execute : ContractId FacilityAgreement
      with
        committedTotal : Decimal
      controller agent
      do
        assertMsg "committed total must be positive" (committedTotal > 0.0)
        assertMsg "committed total exceeds mandate" (committedTotal <= terms.totalAmount)
        create FacilityAgreement with
          borrower       = borrower
          agent          = agent
          terms          = terms
          facilityAmount = committedTotal
          drawn          = 0.0

template FacilityAgreement
  with
    borrower       : Party
    agent          : Party
    terms          : FacilityTerms
    facilityAmount : Decimal
    drawn          : Decimal
  where
    signatory borrower, agent

    ensure facilityAmount > 0.0
      && facilityAmount <= terms.totalAmount
      && drawn >= 0.0
      && drawn <= facilityAmount

    -- non-consuming: several requests can be in flight; availability is
    -- enforced again when the agent applies the drawdown
    nonconsuming choice RequestDrawdown : ContractId DrawdownRequest
      with
        amount : Decimal
      controller borrower
      do
        assertMsg "drawdown must be positive" (amount > 0.0)
        assertMsg "exceeds available amount" (amount <= facilityAmount - drawn)
        create DrawdownRequest with
          borrower   = borrower
          agent      = agent
          facilityId = terms.facilityId
          amount     = amount

    nonconsuming choice NotifyRepayment : ContractId RepaymentNotice
      with
        principal : Decimal
        interest  : Decimal
      controller borrower
      do
        assertMsg "nothing to repay" (principal + interest > 0.0)
        create RepaymentNotice with
          borrower   = borrower
          agent      = agent
          facilityId = terms.facilityId
          principal  = principal
          interest   = interest

    -- consuming: an "update" archives this version and creates the next one
    choice ApplyDrawdown : ContractId FacilityAgreement
      with
        amount : Decimal
      controller agent
      do
        assertMsg "exceeds available amount" (amount <= facilityAmount - drawn)
        create this with drawn = drawn + amount

    choice ApplyRepayment : ContractId FacilityAgreement
      with
        principal : Decimal
      controller agent
      do
        assertMsg "repays more than drawn" (principal <= drawn)
        create this with drawn = drawn - principal

template DrawdownRequest
  with
    borrower   : Party
    agent      : Party
    facilityId : Text
    amount     : Decimal
  where
    signatory borrower
    observer agent

    ensure amount > 0.0

    choice Approve : (ContractId FacilityAgreement, ContractId Drawdown)
      with
        facilityCid : ContractId FacilityAgreement
      controller agent
      do
        fac <- fetch facilityCid
        assertMsg "wrong facility" (fac.terms.facilityId == facilityId && fac.borrower == borrower)
        newFac <- exercise facilityCid ApplyDrawdown with amount = amount
        dd <- create Drawdown with
          borrower   = borrower
          agent      = agent
          facilityId = facilityId
          amount     = amount
        pure (newFac, dd)

    choice RejectDrawdown : ()
      with
        reason : Text
      controller agent
      do pure ()

template Drawdown
  with
    borrower   : Party
    agent      : Party
    facilityId : Text
    amount     : Decimal
  where
    signatory borrower, agent

template RepaymentNotice
  with
    borrower   : Party
    agent      : Party
    facilityId : Text
    principal  : Decimal
    interest   : Decimal
  where
    signatory borrower
    observer agent

    ensure principal >= 0.0 && interest >= 0.0

    choice Acknowledge : ContractId FacilityAgreement
      with
        facilityCid : ContractId FacilityAgreement
      controller agent
      do
        fac <- fetch facilityCid
        assertMsg "wrong facility" (fac.terms.facilityId == facilityId && fac.borrower == borrower)
        exercise facilityCid ApplyRepayment with principal = principal
